@"
# Environment files
.env
.env.*
!.env.example

# Dependencies & build outputs
vendor/
node_modules/
dist/
build/
.next/
bootstrap/cache/*.php
!bootstrap/cache/.gitignore
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/logs/*.log
"@ | Out-File -FilePath .gitignore -Encoding utf8